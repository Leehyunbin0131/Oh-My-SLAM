<!-- One recovery budget for the entire goal. No nested retries or costmap clears. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="NavigateBounded">
      <PipelineSequence name="PlanAndFollow">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"
                             error_code_id="{compute_path_error_code}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"
                    goal_checker_id="goal_checker" progress_checker_id="progress_checker"
                    error_code_id="{follow_path_error_code}"/>
      </PipelineSequence>
      <Sequence name="StopWaitThenRetry">
        <CancelControl/>
        <Wait wait_duration="2.0"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
