<?xml version="1.0"?>
<package format="3">
  <name>omslam_navigation</name>
  <version>0.1.0</version>
  <description>Minimal standard Nav2 navigation with LiDAR SLAM/AMCL, State Lattice and DWB.</description>
  <maintainer email="hyunlee@users.noreply.github.com">Hyun Lee</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>dwb_plugins</exec_depend>
  <exec_depend>dwb_critics</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_behavior_tree</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>omslam_base</exec_depend>
  <exec_depend>omslam_sim</exec_depend>
  <exec_depend>omslam_mapping</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
