From: Oh_My_SLAM maintainers
Subject: [PATCH] Preserve continuous Smac collision coordinates

Upstream: https://github.com/ros-navigation/navigation2
Commit: f4108e5b1c2bce804a1aa0c7be6673a8eb4a1501 (tag 1.3.13)

worldToMapContinuous, lattice expansion, and getWorldCoords use continuous
cell-boundary coordinates. Remove the center lookup half-cell offset and
reuse getWorldCoords for the footprint so checked and returned poses agree.
The integer-index collision overload and all collision thresholds are unchanged.
Install the source provenance, original license, and this patch alongside the
upstream package assets. Apply from the upstream nav2_smac_planner directory.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -139,6 +139,9 @@
 
 install(DIRECTORY lattice_primitives/sample_primitives DESTINATION share/${PROJECT_NAME})
 
+install(FILES provenance.json LICENSE DESTINATION share/${PROJECT_NAME})
+install(DIRECTORY patches DESTINATION share/${PROJECT_NAME})
+
 if(BUILD_TESTING)
   find_package(ament_lint_auto REQUIRED)
   set(AMENT_LINT_AUTO_FILE_EXCLUDE include/nav2_smac_planner/thirdparty/robin_hood.h)
--- a/src/collision_checker.cpp
+++ b/src/collision_checker.cpp
@@ -13,6 +13,7 @@
 // limitations under the License. Reserved.
 
 #include "nav2_smac_planner/collision_checker.hpp"
+#include "nav2_smac_planner/utils.hpp"
 
 namespace nav2_smac_planner
 {
@@ -114,9 +115,10 @@
     return true;
   }
 
-  // Assumes setFootprint already set
+  // Continuous map coordinates use cell boundaries, as worldToMapContinuous does.
+  // Assumes setFootprint already set.
   center_cost_ = static_cast<float>(costmap_->getCost(
-    static_cast<unsigned int>(x + 0.5f), static_cast<unsigned int>(y + 0.5f)));
+    static_cast<unsigned int>(x), static_cast<unsigned int>(y)));
 
   if (!footprint_is_radius_) {
     // if footprint, then we check for the footprint's points, but first see
@@ -138,8 +140,11 @@
     // if possible inscribed, need to check actual footprint pose.
     // Use precomputed oriented footprints are done on initialization,
     // offset by translation value to collision check
-    double wx, wy;
-    costmap_->mapToWorld(static_cast<double>(x), static_cast<double>(y), wx, wy);
+    // Use the same continuous conversion as the returned path. mapToWorld takes
+    // integer cell indices and would snap this pose to a cell center.
+    const auto world_pose = getWorldCoords(x, y, costmap_);
+    const double wx = world_pose.position.x;
+    const double wy = world_pose.position.y;
     geometry_msgs::msg::Point new_pt;
     const nav2_costmap_2d::Footprint & oriented_footprint = oriented_footprints_[angle_bin];
     nav2_costmap_2d::Footprint current_footprint;
