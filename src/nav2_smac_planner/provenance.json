  "vendoring": {
    "destination": "src/nav2_smac_planner",
    "scope": "Complete upstream nav2_smac_planner package plus the original repository LICENSE.",
    "reason": "Keep the Nav2 1.3.13 plugin reproducible in ordinary workspace builds without fetching an external checkout.",
    "plugin": "nav2_smac_planner::SmacPlannerLattice"
  },
  "patches": [
    {
      "path": "patches/0001-preserve-continuous-grid-coordinates.patch",
      "sha256": "545e1e7a38afd6d3b184153a44028c64da6b2e3edceb1323a6acef018b4cd1e8",
      "apply_from": "nav2_smac_planner",
      "changed_upstream_files": [
        "CMakeLists.txt",
        "src/collision_checker.cpp"
      ],
      "reason": "The continuous collision overload rounded center indices upward by half a cell and implicitly truncated footprint coordinates through Costmap2D::mapToWorld(unsigned int, unsigned int, ...). This could reject a physically valid pose when its grid coordinate crossed an integer boundary. Use the containing center cell and the same continuous world conversion as the returned path.",
      "unchanged": [
        "Integer-index collision overload",
        "A* search",
        "Motion primitives",
        "Start and goal handling",
        "Returned path conversion",
        "Footprint geometry and padding",
        "Lethal and unknown collision thresholds"
      ]
    },
    {
      "path": "patches/0002-reject-smoother-boundary-outside-map.patch",
      "sha256": "a7391511be5c6c188afa5becd22cb00b483d2bd8437c3558605c2ff3e5f255d6",
      "apply_from": "nav2_smac_planner",
      "changed_upstream_files": [
        "src/smoother.cpp",
        "test/CMakeLists.txt"
      ],
      "added_files": [
        "test/test_smoother_bounds.cpp"
      ],
      "reason": "Actual native GUI automatic SLAM run crashed in findBoundaryExpansion/getCost when a Dubins smoothing candidate left the map. Reject failed worldToMap conversion before indexing; keep collision thresholds and valid in-map candidates unchanged."
    },
    {
      "path": "patches/0003-validate-final-footprints-and-bounds.patch",
      "sha256": "e29e9c77b7c3507477d83e50d7c2d2b5f51dca0def33285bd724a1c127b38e89",
      "apply_from": "nav2_smac_planner",
      "changed_upstream_files": [
        "src/collision_checker.cpp",
        "src/smoother.cpp",
        "src/smac_planner_lattice.cpp",
        "test/test_smac_lattice.cpp",
        "test/CMakeLists.txt"
      ],
      "added_files": [
        "include/nav2_smac_planner/path_validation.hpp",
        "test/test_path_validation.cpp"
      ],
      "reason": "Review regression fixes: reject exclusive upper bounds/nonfinite coordinates and smoother out-of-map candidates; validate filled final footprints with continuous orientation and half-cell interpolation, validate raw fallback or fail closed."
    },
    {
      "path": "patches/0004-align-terminal-path-with-controller.patch",
      "sha256": "ea10b6432a72750e80e8cff4104febd1538d1def94c61e518b791480519204da",
      "apply_from": "nav2_smac_planner",
      "changed_upstream_files": [
        "include/nav2_smac_planner/smac_planner_lattice.hpp",
        "src/smac_planner_lattice.cpp",
        "test/CMakeLists.txt"
      ],
      "added_files": [
        "test/test_lattice_terminal.cpp"
      ],
      "reason": "Optional controller-aligned Euclidean terminal window for diff/omni lattices preserves the exact goal on every returned path and validates full in-place yaw sweep plus bounded terminal connector. Near-goal handoff avoids curvature-search loops without marking navigation complete. Startup-only threshold remains separate from A* heuristic fallback tolerance; original lattice smoothing precedes the exact-goal connector."
    },
    {
      "path": "patches/0005-validate-start-and-incoming-lattice-edges.patch",
      "sha256": "72d7d681b9425f3469ded1486227f89951f16007717de58be1d4e4a2f585d1a4",
      "apply_from": "nav2_smac_planner",
      "changed_upstream_files": [
        "include/nav2_smac_planner/collision_checker.hpp",
        "include/nav2_smac_planner/node_lattice.hpp",
        "src/analytic_expansion.cpp",
        "src/collision_checker.cpp",
        "src/node_lattice.cpp",
        "src/node_hybrid.cpp",
        "src/smac_planner_lattice.cpp"
      ],
      "changed_local_files": [
        "test/test_lattice_terminal.cpp"
      ],
      "reason": "Validate the continuous start, incoming lattice primitives, and analytic shortcuts against the swept filled footprint. Retain independent final validation. Index lethal and prohibited unknown cells once per search and query each occupied polygon column span for efficient checks beside inflated or unknown boundaries. Calculate incoming costs independently and wrap reflected heading indices."
    },
    {
      "path": "patches/0006-preserve-terminal-turn-and-timeout.patch",
      "sha256": "200fc84265e18aad3318ca722ab3405e4e711bd9b207f8712cc6ec50a5f4f5fd",
      "apply_from": "nav2_smac_planner",
      "changed_upstream_files": [
        "src/a_star.cpp",
        "src/smac_planner_lattice.cpp",
        "src/node_lattice.cpp"
      ],
      "changed_local_files": [
        "test/test_lattice_terminal.cpp"
      ],
      "reason": "Check both terminal rotation directions and start-heading connectors, preserve better lattice neighbors, reject out-of-grid endpoints, and propagate planning timeouts."
    }
  ],
