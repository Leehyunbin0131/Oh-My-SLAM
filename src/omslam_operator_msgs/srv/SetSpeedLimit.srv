string token
uint64 epoch
string request_id
# Manual limits in m/s and rad/s, both strictly positive.
float64 linear_limit
float64 angular_limit
# AUTO limit in percent, 100 * min_wheel_rpm / max_wheel_rpm through 100.
float64 speed_percent
# Per-wheel upper limit, from min_wheel_rpm through max_wheel_rpm.
# Zero derives the limit from speed_percent for older clients.
float64 wheel_rpm_limit
---
bool success
string message
float64 linear_limit
float64 angular_limit
float64 speed_percent
float64 wheel_rpm_limit
