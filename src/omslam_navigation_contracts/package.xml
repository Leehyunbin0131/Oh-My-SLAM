<?xml version="1.0"?>
<package format="3">
  <name>omslam_navigation_contracts</name><version>0.1.0</version>
  <description>Speed-aware Nav2 controller plugins and installed navigation boundary fixtures.</description>
  <maintainer email="Leehyunbin0131@users.noreply.github.com">Leehyunbin0131</maintainer>
  <license>Apache-2.0</license><buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>nav2_util</depend><depend>nav2_core</depend>
